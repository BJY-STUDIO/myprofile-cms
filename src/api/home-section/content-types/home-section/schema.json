{
  "kind": "collectionType",
  "collectionName": "home_sections",
  "info": {
    "singularName": "home-section",
    "pluralName": "home-sections",
    "displayName": "Home Section"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "headingLevel": {
      "type": "enumeration",
      "enum": ["section-header", "sub-heading", "small-heading"],
      "default": "sub-heading",
      "required": true
    },
    "noJumplink": {
      "type": "boolean",
      "default": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "sectionId": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "maxArticles": {
      "type": "integer",
      "default": 6
    },
    "titleAlignment": {
      "type": "enumeration",
      "enum": ["left", "center", "right"],
      "default": "left"
    },
    "titleColor": {
      "type": "string",
      "default": "#111827"
    },
    "topSpacing": {
      "type": "enumeration",
      "enum": ["none", "small", "medium", "large"],
      "default": "large"
    },
    "bottomSpacing": {
      "type": "enumeration",
      "enum": ["none", "small", "medium", "large"],
      "default": "large"
    },
    "divider": {
      "type": "boolean",
      "default": false
    },
    "dividerStyle": {
      "type": "enumeration",
      "enum": ["solid", "dashed", "dotted"],
      "default": "solid"
    },
    "featureArticle": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::article.article"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article"
    }
  }
}
